<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="features" nsURI="urn:features" nsPrefix="features">
  <eAnnotations source="urn:documentation"><details key="summary" value="Feature corpus"/></eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Entity">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parent" eType="#//Entity" resolveProxies="false"/>
    <eOperations name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eParameters name="prefix" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="State"><eLiterals name="ACTIVE" value="1" literal="active"/></eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="Identifier" instanceClassName="java.lang.String" serializable="true"/>
</ecore:EPackage>

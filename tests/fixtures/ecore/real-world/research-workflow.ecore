<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="researchWorkflow" nsURI="urn:ecore-visualizer:research-workflow" nsPrefix="research">
  <eAnnotations source="urn:ecore-visualizer:documentation">
    <details key="purpose" value="Realistic research data and project workflow regression model"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Identified" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Named" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true" eSuperTypes="#//Identified #//Named">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Researcher" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects" upperBound="-1" eType="#//ResearchProject" eOpposite="#//ResearchProject/members"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="leads" upperBound="-1" eType="#//ResearchProject" eOpposite="#//ResearchProject/lead"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="institution" eType="#//Institution" eOpposite="#//Institution/staff"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Institution" eSuperTypes="#//Identified #//Named">
    <eStructuralFeatures xsi:type="ecore:EReference" name="staff" upperBound="-1" eType="#//Researcher" eOpposite="#//Researcher/institution"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects" upperBound="-1" eType="#//ResearchProject"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResearchProject" eSuperTypes="#//Identified #//Named">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" eType="#//ProjectStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="members" upperBound="-1" eType="#//Researcher" eOpposite="#//Researcher/projects"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lead" lowerBound="1" eType="#//Researcher" eOpposite="#//Researcher/leads"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="outputs" upperBound="-1" containment="true" eType="#//Publication" eOpposite="#//Publication/project"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="datasets" upperBound="-1" containment="true" eType="#//Dataset" eOpposite="#//Dataset/project"/>
    <eOperations name="release" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eParameters name="version" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Artifact" abstract="true" eSuperTypes="#//Identified #//Named">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="createdAt" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Citable" interface="true" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="citation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Publication" eSuperTypes="#//Artifact #//Citable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="doi" eType="#//Doi"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="project" eType="#//ResearchProject" eOpposite="#//ResearchProject/outputs"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors" lowerBound="1" upperBound="-1" eType="#//Researcher"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Dataset" eSuperTypes="#//Artifact #//Citable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="checksum" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="project" eType="#//ResearchProject" eOpposite="#//ResearchProject/datasets"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="curators" upperBound="-1" eType="#//Researcher"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ProjectStatus">
    <eLiterals name="PROPOSED" value="0" literal="proposed"/>
    <eLiterals name="ACTIVE" value="1" literal="active"/>
    <eLiterals name="COMPLETED" value="2" literal="completed"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="Doi" instanceClassName="java.lang.String"/>
</ecore:EPackage>

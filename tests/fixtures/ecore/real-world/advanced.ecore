<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="research" nsURI="urn:research" nsPrefix="research">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel"><details key="documentation" value="Advanced semantic regression model"/></eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Identified"><eStructuralFeatures xsi:type="ecore:EAttribute" name="id" iD="true" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Repository" eSuperTypes="#//Identified">
    <eTypeParameters name="T"><eBounds eClassifier="#//Identified"/></eTypeParameters>
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1" containment="true"><eGenericType eTypeParameter="#//Repository/T"/></eStructuralFeatures>
    <eOperations name="find" eExceptions="#//RepositoryError"><eGenericType eTypeParameter="#//Repository/T"/><eParameters name="key" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/></eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RepositoryError"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Status"><eLiterals name="READY" value="10" literal="ready"/></eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="Money" instanceClassName="java.math.BigDecimal"/>
</ecore:EPackage>
